{
  "name": "vite-plugin-bundle-guardian",
  "version": "1.0.0",
  "description": "构建产物治理插件：体积预算门禁 + 基于 SourceMap 的字节级依赖体积归因",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bei-qian-die/vite-plugin-bundle-guardian.git"
  },
  "bugs": {
    "url": "https://github.com/bei-qian-die/vite-plugin-bundle-guardian/issues"
  },
  "homepage": "https://github.com/bei-qian-die/vite-plugin-bundle-guardian#readme",
  "keywords": ["vite", "vite-plugin", "rollup-plugin", "bundle-size", "budget", "dependency-analysis", "sourcemap"],
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/emit-cjs-pkg.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@bundle-guardian/core": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
